<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force HTTPS on cPanel production (preserve localhost/IP testing)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forward Authorization header for API requests
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct web access to sensitive directories and manifests
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(backend|src|docs|\.git) - [F,L]
    RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.cpanel\.yml)$ - [F,L]
    RewriteRule \.(sql|log|lock|sh)$ - [F,L]

    # Route backend endpoints, dynamic XML sitemap, and robots.txt to Laravel index.php
    RewriteCond %{REQUEST_URI} ^/(api|sanctum|sitemap\.xml|robots\.txt) [NC]
    RewriteRule ^ index.php [L]

    # Serve existing static frontend assets, uploaded media, or built JS/CSS directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback all SPA client routes to Laravel web controller (adds X-Robots-Tag noindex on admin/install)
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
