<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Enforce HTTPS when available on cPanel
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Security Headers
    <IfModule mod_headers.c>
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    </IfModule>

    # Block direct access to sensitive files
    <FilesMatch "^\.(env|git|htaccess)">
        Require all denied
    </FilesMatch>

    # Pass Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route API, Sanctum CSRF, Sitemap, and Robots requests to Laravel
    RewriteCond %{REQUEST_URI} ^/(api|sanctum|sitemap\.xml|robots\.txt) [NC]
    RewriteRule ^ index.php [L]

    # Serve existing static files (assets, images, uploads) directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback all frontend routes to React SPA index.html
    RewriteRule ^ index.html [L]
</IfModule>
