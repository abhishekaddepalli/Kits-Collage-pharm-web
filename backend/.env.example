APP_NAME="KITS College of Pharmacy for Women"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://kitspharmacy.ac.in

# Configurable private administration routes (never linked publicly)
APP_ADMIN_LOGIN_PATH=/admin-login
APP_ADMIN_PANEL_PATH=/control-panel

# cPanel MySQL 8.0+ / MariaDB 10.6+ connection (written cleanly during /install)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Secure HTTP-only session & Sanctum configuration (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=kitspharmacy.ac.in,www.kitspharmacy.ac.in,localhost:3000

CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Mail configuration for password resets & enquiry notifications (configure cPanel SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.kitspharmacy.ac.in
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=kitspharmacollege@gmail.com
MAIL_FROM_NAME="KITS College of Pharmacy for Women"

# Optional Server-Side Gemini API Key for KITS AI Assistant (FAQ engine works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
