# Optional Gemini API key for server-side KITS AI Assistant fallback (beyond verified database FAQs)
GEMINI_API_KEY=

# Optional local dev preview session HMAC secret (auto-generated on first run if blank)
SESSION_SECRET=

# Optional overrides for private admin routes before installation
VITE_ADMIN_LOGIN_PATH=/admin-login
VITE_ADMIN_PANEL_PATH=/control-panel
VITE_API_BASE_URL=/api/v1
